# ===== إعدادات بوت تحويل العملات =====
# انسخ هذا الملف باسم .env وعبّي القيم دي

# توكن البوت من BotFather على تلجرام (مطلوب)
BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# مفتاح API اختياري - لو مش موجود البوت هيشتغل بمصدر مجاني
# المصدر المجاني بيدعم 161+ عملة وبيدي بيانات محدّثة كل ساعة
# لو عايز تطوّره: سجل من https://www.exchangerate-api.com/
EXCHANGE_API_KEY=
